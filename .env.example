# ---------------------------------------------------------------------------
# SEO OS configuration
#
# Nothing below is required to start. With an empty file the platform runs on
# SQLite, crawls and audits any public site, and marks generative steps as
# degraded rather than failing. Fill things in as you need them.
# ---------------------------------------------------------------------------

SEOOS_ENVIRONMENT=dev
SEOOS_PUBLIC_URL=http://localhost:8000
SEOOS_WEB_URL=http://localhost:3000

# --- security --------------------------------------------------------------
# Generate both with:  seoos keygen
# Losing the master key makes every stored credential unrecoverable. Back it up.
SEOOS_MASTER_KEY=
SEOOS_JWT_SECRET=
# Set to false in production so a missing key is a hard failure.
SEOOS_ALLOW_INSECURE_DEV_KEYS=true

# --- database --------------------------------------------------------------
# SQLite is fine for development and single-tenant demos. It has one writer at
# a time, so anything running real concurrency wants Postgres.
SEOOS_DATABASE_URL=sqlite+aiosqlite:///./var/seoos.db
# SEOOS_DATABASE_URL=postgresql+asyncpg://seoos:seoos@localhost:5432/seoos

# --- model access ----------------------------------------------------------
# Any one of these enables the generative agents. A tenant may also bring
# their own key through the UI, in which case their workload never touches
# the platform's account.
SEOOS_DEFAULT_LLM_PROVIDER=anthropic
# SEOOS_ANTHROPIC_API_KEY=
# SEOOS_OPENAI_API_KEY=
# SEOOS_GOOGLE_API_KEY=
# SEOOS_OPENROUTER_API_KEY=
# SEOOS_AZURE_OPENAI_ENDPOINT=
# SEOOS_AZURE_OPENAI_API_KEY=
# Local inference: nothing leaves the network and nothing is billed per token.
# SEOOS_OLLAMA_BASE_URL=http://localhost:11434/v1

# --- OAuth clients ---------------------------------------------------------
# Needed only for the hosted sign-in flows. Without them a client can still
# connect by pasting a refresh token.
# SEOOS_GOOGLE_CLIENT_ID=
# SEOOS_GOOGLE_CLIENT_SECRET=
# SEOOS_LINKEDIN_CLIENT_ID=
# SEOOS_LINKEDIN_CLIENT_SECRET=
# SEOOS_SHOPIFY_CLIENT_ID=
# SEOOS_SHOPIFY_CLIENT_SECRET=

# --- platform-level data providers -----------------------------------------
# Optional fallbacks. A tenant's own keys always take precedence.
# SEOOS_DATAFORSEO_LOGIN=
# SEOOS_DATAFORSEO_PASSWORD=
# SEOOS_MOZ_ACCESS_ID=
# SEOOS_MOZ_SECRET_KEY=
# SEOOS_SERPER_API_KEY=

# --- crawling --------------------------------------------------------------
SEOOS_USER_AGENT=SEO-OS/0.1 (+https://github.com/jishhnnuu/seo-aeo-geo)
SEOOS_CRAWL_CONCURRENCY=6
SEOOS_CRAWL_DELAY_MS=250
SEOOS_RESPECT_ROBOTS_TXT=true

# --- spend ceilings --------------------------------------------------------
# Hard caps no organisation can exceed, whatever an agent decides.
SEOOS_MAX_USD_PER_RUN=25
SEOOS_MAX_USD_PER_ORG_PER_DAY=200
SEOOS_MAX_TOOL_CALLS_PER_RUN=120
# Set true to make every mutating tool a no-op that logs what it would do.
SEOOS_DRY_RUN=false

# --- storage and mail ------------------------------------------------------
SEOOS_STORAGE_DIR=./var/storage
# SEOOS_SMTP_HOST=
# SEOOS_SMTP_USER=
# SEOOS_SMTP_PASSWORD=
SEOOS_MAIL_FROM=seo-os@localhost

SEOOS_LOG_LEVEL=INFO
SEOOS_LOG_FORMAT=console
