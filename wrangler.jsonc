{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fullseoaeogeotool",
  "main": "apps/web/.open-next/worker.js",
  "compatibility_date": "2025-09-01",
  // Next's server bundle reaches for node: builtins; nodejs_compat supplies them.
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare's dashboard runs `npx wrangler deploy` with no build step, so
  // the build is declared here instead. That keeps the deployment working
  // without anyone having to change a setting in the dashboard.
  "build": {
    "command": "npm run cf:build"
  },

  "assets": {
    "directory": "apps/web/.open-next/assets",
    "binding": "ASSETS"
  },

  // No vars are needed. The Worker serves the dashboard and the two engine
  // endpoints it calls; the workspace lives in the visitor's browser. Setting
  // SEOOS_API_URL as a Worker variable additionally proxies /api/v1 to a
  // self-hosted Python service, read per request, with no rebuild.

  "observability": {
    "enabled": true
  }
}
