{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fullseoaeogeotool",
  // Not the generated worker directly: `deploy/worker.js` re-exports it and
  // adds the `scheduled` handler Cloudflare needs before a cron trigger fires.
  "main": "deploy/worker.js",
  "compatibility_date": "2025-09-01",
  // Next's server bundle reaches for node: builtins; nodejs_compat supplies them.
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare's dashboard runs `npx wrangler deploy` with no build step, so
  // the build is declared here instead. That keeps the deployment working
  // without anyone having to change a setting in the dashboard.
  "build": {
    "command": "npm run cf:build"
  },

  "assets": {
    "directory": "apps/web/.open-next/assets",
    "binding": "ASSETS"
  },

  // Accounts, OAuth tokens and the publish log live in D1. There is no
  // database_id on purpose: Wrangler provisions a binding that names a
  // database but no id. On a deploy it connects to the database called
  // "seoos" if one exists, creates it if not, and on later deploys inherits
  // the binding the Worker already has. So nobody has to create a database
  // or paste an id, from a laptop or the dashboard. The tables then build
  // themselves on the first request (src/server/schema.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seoos",
      "migrations_dir": "deploy/d1/migrations"
    }
  ],
  //
  // Everything the database serves degrades with a stated reason while it is
  // missing: the audit runs, the workspace stays in the browser, and the
  // sign-in screen says why there is nothing to sign in to.
  //
  // Secrets are set in the dashboard (this Worker, Settings, Variables and
  // Secrets) or with `npx wrangler secret put NAME`, never written here.
  // /app/setup on the running deployment says which are still missing, and
  // generates a master key in the browser:
  //   SEOOS_MASTER_KEY       seals every stored credential (openssl rand -base64 32)
  //   GOOGLE_CLIENT_ID       the OAuth client, for sign-in and for Search Console
  //   GOOGLE_CLIENT_SECRET
  //   RESEND_API_KEY         optional, turns on the magic-link fallback
  //   PUBLIC_BASE_URL        optional, pins the OAuth redirect to a custom domain
  //
  // SEOOS_API_URL additionally proxies /api/v1 to a self-hosted Python
  // service, read per request, with no rebuild.

  // Hourly. Each firing runs the jobs that can work with nobody present: the
  // measurement sample and the report. The audit runs in the browser, so a
  // scheduled crawl waits for the next time the app is opened, and the
  // schedule screen says so rather than implying otherwise.
  //
  // Cron triggers are included on the free plan. If none is configured the
  // rest of the Worker is unaffected; nothing here is load-bearing for the
  // audit.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
